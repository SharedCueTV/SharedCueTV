{
  "name": "sharedcuetv",
  "private": true,
  "description": "SharedCueTV – gemeinsam schauen mit Freunden (statische Seite, GitHub Pages + Supabase Realtime)",
  "scripts": {
    "build": "node tools/build.mjs",

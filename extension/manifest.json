{
  "manifest_version": 3,
  "name": "SharedCueTV – Netflix, Disney+ & Prime",
  "short_name": "SharedCueTV",
  "version": "0.1.0",
  "description": "Netflix, Disney+ und Prime Video synchron mit Freunden schauen. Jeder nutzt sein eigenes Abo.",
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "SharedCueTV" },
  "background": { "service_worker": "bg.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://pvwgktntvrzcmivxsiaf.supabase.co/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.disneyplus.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.de/*",
        "https://www.amazon.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["netflix-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
